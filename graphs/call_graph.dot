  }
  subgraph "cluster_lib.mask" {
    label="lib.mask"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.mask.build_database" [label="build_database", fillcolor="#fff6cc", shape=box];
    "lib.mask.repeatmodeler" [label="repeatmodeler", fillcolor="#fff6cc", shape=box];
    "lib.mask.repeatmasker" [label="repeatmasker", fillcolor="#fff6cc", shape=box];
  }
  subgraph "cluster_lib.polish" {
    label="lib.polish"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.polish.racon_round" [label="racon_round", fillcolor="#cfe8ff", shape=box];
    "lib.polish.polypolish" [label="polypolish", fillcolor="#cfe8ff", shape=box];
    "lib.polish.nextpolish_round" [label="nextpolish_round", fillcolor="#cfe8ff", shape=box];
  }
  subgraph "cluster_lib.qc" {
    label="lib.qc"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.qc.seqkit_stats" [label="seqkit_stats", fillcolor="#d9f2d9", shape=box];
    "lib.qc.longreadsum" [label="longreadsum", fillcolor="#d9f2d9", shape=box];
    "lib.qc.fastqc" [label="fastqc", fillcolor="#d9f2d9", shape=box];
    "lib.qc.multiqc" [label="multiqc", fillcolor="#d9f2d9", shape=box];
  }
  subgraph "cluster_lib.scaffold" {
    label="lib.scaffold"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.scaffold.ragtag" [label="ragtag", fillcolor="#ffe8cc", shape=box];
  }
  subgraph "cluster_scripts.01_download" {
    label="scripts.01_download"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "scripts.01_download" [label="scripts.01_download", fillcolor="#f4d9ff", shape=component];
  }
  subgraph "cluster_scripts.02_assembly" {
