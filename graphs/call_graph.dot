digraph call_graph {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
  edge [color="#888888"];
  subgraph "cluster_lib.assemble" {
    label="lib.assemble"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.assemble.flye" [label="flye", fillcolor="#cfe8ff", shape=box];
    "lib.assemble.raven" [label="raven", fillcolor="#cfe8ff", shape=box];
    "lib.assemble.wtdbg2" [label="wtdbg2", fillcolor="#cfe8ff", shape=box];
  }
  subgraph "cluster_lib.decontaminate" {
    label="lib.decontaminate"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.decontaminate.kraken2_single" [label="kraken2_single", fillcolor="#d9f2d9", shape=box];
    "lib.decontaminate.kraken2_paired" [label="kraken2_paired", fillcolor="#d9f2d9", shape=box];
  }
  subgraph "cluster_lib.download" {
    label="lib.download"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.download.ensure_seqfetcher" [label="ensure_seqfetcher", fillcolor="#ffe8cc", shape=box];
    "lib.download.sra_reads" [label="sra_reads", fillcolor="#ffe8cc", shape=box];
  }
  subgraph "cluster_lib.evaluate" {
    label="lib.evaluate"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.evaluate.busco" [label="busco", fillcolor="#f4d9ff", shape=box];
    "lib.evaluate.quast" [label="quast", fillcolor="#f4d9ff", shape=box];
    "lib.evaluate.quast_reference" [label="quast_reference", fillcolor="#f4d9ff", shape=box];
    "lib.evaluate.meryl_count" [label="meryl_count", fillcolor="#f4d9ff", shape=box];
    "lib.evaluate.merqury" [label="merqury", fillcolor="#f4d9ff", shape=box];
  }
  subgraph "cluster_lib.filter" {
    label="lib.filter"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.filter.pacbio" [label="pacbio", fillcolor="#ffe0e0", shape=box];
    "lib.filter.illumina" [label="illumina", fillcolor="#ffe0e0", shape=box];
  }
  subgraph "cluster_lib.io" {
    label="lib.io"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "lib.io.run_tool" [label="run_tool", fillcolor="#e0f7f5", shape=box];
    "lib.io.log_step" [label="log_step", fillcolor="#e0f7f5", shape=box];
