    "scripts.04_env" [label="scripts.04_env", fillcolor="#fff6cc", shape=component];
  }
  subgraph "cluster_scripts.check_deps" {
    label="scripts.check_deps"; style="dashed"; fontname="Helvetica"; fontsize=11;
    "scripts.check_deps" [label="scripts.check_deps", fillcolor="#cfe8ff", shape=component];
    "scripts.check_deps.check" [label="check", fillcolor="#cfe8ff", shape=box];
  }
  "lib.assemble.flye" -> "lib.io.run_tool";
  "lib.assemble.raven" -> "lib.io.run_tool";
  "lib.assemble.wtdbg2" -> "lib.io.run_tool";
